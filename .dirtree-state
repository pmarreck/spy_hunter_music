# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	.github/workflows/pages.yml = GitHub Pages build of zig-out/web
	PLAN.md = Implementation checkpoints and gun-sound regression follow-up
	build.zig = Zig build: Musashi opcode generation, C cores, core tests, static lib and C CLI
	build.zig.zon = Pinned Musashi and floooh/chips source dependencies
	docs/MUSIC_INVESTIGATION.md = ROM evidence for fixed score, synthesis and algorithmic solo variation
	docs/PLAN_LOG.md = Append-only log of completed PLAN items
	docs/TERMINALS.md = Verified key-release support per terminal/multiplexer with sources
	include/spy_hunter.h = Public C ABI of the Zig core (length-delimited buffers, single board per process)
	serve = Build and serve the web player on 127.0.0.1 with the assets/ background
	src = Zig core (src/core) and C CLI (src/cli)
	src/cli/audio.h = Playback port: SDL2 on Unix, waveOut on Windows
	src/cli/audio_sdl.c = SDL2 48 kHz float playback for Linux and macOS
	src/cli/audio_windows.c = winmm waveOut 16-bit playback for the Windows build
	src/cli/main.c = C CLI: args, ROM discovery, inspect/render/play, SDL2 audio, status lines
	src/cli/terminal.c = Raw terminal, kitty flag push/query/pop, signal-safe restore
	src/cli/terminal_keys.c = Maps Windows virtual keys to kitty CSI-u sequences
	src/cli/terminal_keys.h = Declaration for the Windows virtual-key encoder
	src/cli/terminal_windows.c = Windows console key-up adapter that emits kitty CSI-u bytes
	src/core/board.zig = Board wiring ported from sound.c: 68000 PIA/DAC, SSIO latches, AY mix, command acknowledgment
	src/core/chips_impl.c = Single implementation unit for header-only chips cores
	src/core/controller.zig = Pure controller: death resume, hold/tap guns, pause deadline shifting
	src/core/cores.h = C declarations of Musashi and chips for translate-c
	src/core/ffi.zig = C ABI exports: admission, boot, render, session (keys/guns/pause), gain, WAV
	src/core/keyboard.zig = Legacy byte and kitty CSI-u key decoding plus control mapping
	src/core/lib.zig = Library root that exports the C ABI
	src/core/rom.zig = Sound-ROM admission and sound-image SHA-1 check
	src/core/root.zig = Test root referencing every core module
	src/core/terminal.zig = Terminal/multiplexer detection from env plus kitty probe verdict
	src/core/tips.zig = --tips advice rendering (text, color, JSON) per terminal and multiplexer
	src/core/wav.zig = WAV header and PCM16 sample encoding
	src/core/zip.zig = Bounds-checked in-memory ZIP member lookup, inflate and CRC-32
	src/web/compat/setjmp.h = Wasm-only setjmp shim (Musashi bus-error trap point never longjmps)
	src/web/sound_image.bin = Seven sound-board members in admitted-image layout
	src/web/sound_image.zig = SHA-1 check of the embedded sound-board image
	src/web/wasm.zig = Wasm root: core C ABI plus sh_alloc/sh_free
	test = Complete test entry point
	tests = One-entrypoint ROM-independent unit, CLI, PTY, build and ZIP regressions
	tests/cli = Bash CLI surface tests against the C binary
	tests/fixtures/fixtures.zig = Embeds generated non-ROM ZIP fixtures for Zig tests
	tests/probe.c = PTY test of the kitty flags probe
	tests/rom/hashes = Per-platform SHA-256 pins of 12 s renders (hashes only)
	tests/rom/run = ROM-gated render hash pins and death-command regression
	tests/rom/wasm-render.mjs = Wasm render to PCM for native parity check
	tests/web/run = Web suite: key classifier and wasm core via Node
	tests/windows/device.c = Wine check: injected console keys and one completed waveOut buffer
	tests/windows/encode.c = Host check that Windows keys encode as kitty CSI-u
	tests/windows/run = Cross-builds x86_64 Windows and runs it under Wine when present
	web/app.js = Main-thread controller: ROM picker (IndexedDB), audio start, buttons, keys
	web/core.js = Synchronous JS adapter for spy_hunter.wasm (WASI stubs, typed API)
	web/index.html = Personal web player page (not published)
	web/keys.js = Browser keydown/keyup to core event mapping
	web/style.css = Cyberpunk console styling over the centered background image
	web/worklet.js = AudioWorklet running the wasm core per 128-sample quantum
]

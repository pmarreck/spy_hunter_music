#!/usr/bin/env bash
# Build and serve the personal web player. Bundles just the seven sound-board
# ROM members from the local spyhunt.zip as zig-out/web/sound.zip (gitignored,
# never committed), and copies the first image in assets/ as the background.
#
# Usage: ./serve [--local] [PORT]
# darkhttpd listens on 127.0.0.1 only. Unless --local is given, a foreground
# `tailscale serve` adds tailnet-only HTTPS on the same port, so phones on
# your tailnet get the secure context AudioWorklet requires. It is never
# Funnel (public), and Tailscale removes it when this script stops.
set -u
cd -- "$(dirname -- "${BASH_SOURCE[0]}")" || exit 1
if ! command -v darkhttpd >/dev/null 2>&1 || ! command -v zip >/dev/null 2>&1; then exec nix develop -c ./serve "$@"; fi
use_tailscale=1
port=8473
for argument in "$@"; do
	case "$argument" in
		--local) use_tailscale=0;;
		-h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
		*[!0-9]*|'') printf 'Unknown argument: %s\n' "$argument" >&2; exit 2;;
		*) port="$argument";;
	esac
done
if [[ $use_tailscale -eq 1 ]]; then
	if ! command -v tailscale >/dev/null 2>&1 || ! tailscale status >/dev/null 2>&1; then
		printf 'Tailscale is not running; serving on this machine only.\n' >&2
		use_tailscale=0
	elif tailscale serve status --json 2>/dev/null | grep -q "\"$port\""; then
		printf 'Port %s is already in your tailscale serve config; choose another: ./serve PORT\n' "$port" >&2
		exit 1
	fi
fi
zig build web || exit 1

rom=''
for candidate in "${SPY_HUNTER_ROM:-}" "$HOME/Code/spy_hunter_music/local/spyhunt.zip" /mnt/Fileserver/Emulation/ROMs/MAME/ROMs/spyhunt.zip "$HOME/ROMs/spyhunt.zip"; do
	[[ -n "$candidate" && -r "$candidate" ]] && { rom="$candidate"; break; }
done
[[ -n "$rom" ]] || { printf 'No spyhunt.zip found. Set SPY_HUNTER_ROM to your local archive.\n' >&2; exit 1; }
# Sound-board members only (legacy name, then current MAME name); the page's
# core verifies sizes and SHA-1s exactly as the CLI does.
members=(
	'csd_u7a.u7:spy-hunter_cs_deluxe_u7_a_11-18-83.u7'
	'csd_u17b.u17:spy-hunter_cs_deluxe_u17_b_11-18-83.u17'
	'csd_u8c.u8:spy-hunter_cs_deluxe_u8_c_11-18-83.u8'
	'csd_u18d.u18:spy-hunter_cs_deluxe_u18_d_11-18-83.u18'
	'snd_0sd.a8:spy-hunter_snd_0_sd_11-18-83.a7'
	'snd_1sd.a7:spy-hunter_snd_1_sd_11-18-83.a8'
	'82s123.12d:82s123.12d'
)
staging="$(mktemp -d "${TMPDIR:-/tmp}/spy-hunter-sound.XXXXXX")" || exit 1
trap 'mv -- "$staging" "${HOME}/.Trash/spy-hunter-sound.$$" 2>/dev/null' EXIT
for pair in "${members[@]}"; do
	name="${pair%%:*}" alias="${pair#*:}"
	unzip -p -- "$rom" "$name" > "$staging/$name" 2>/dev/null && [[ -s "$staging/$name" ]] && continue
	unzip -p -- "$rom" "$alias" > "$staging/$name" 2>/dev/null && [[ -s "$staging/$name" ]] && continue
	printf 'Sound ROM member %s is missing from %s\n' "$name" "$rom" >&2
	exit 1
done
out="$PWD/zig-out/web/sound.zip"
[[ ! -e "$out" ]] || mv -- "$out" "$staging/previous-sound.zip" || exit 1
(cd "$staging" && zip -q -X -9 "$out" "${members[@]%%:*}") || exit 1

background="$(find assets -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | sort | head -1)"
if [[ -n "$background" ]]; then cp -- "$background" zig-out/web/background.png || exit 1
else printf 'No image in assets/; the page background will be plain black.\n' >&2; fi
trap - EXIT
mv -- "$staging" "${HOME}/.Trash/spy-hunter-sound.$$" || exit 1
if [[ $use_tailscale -eq 0 ]]; then
	printf 'Spy Hunter web player: http://127.0.0.1:%s/  (Ctrl-C to stop)\n' "$port" >&2
	exec darkhttpd zig-out/web --addr 127.0.0.1 --port "$port" --index index.html
fi
darkhttpd zig-out/web --addr 127.0.0.1 --port "$port" --index index.html >/dev/null 2>&1 &
server=$!
trap 'kill "$server" 2>/dev/null' EXIT
host="$(tailscale status --json | sed -n 's/.*"DNSName": *"\([^"]*\)\.".*/\1/p' | head -1)"
printf 'Spy Hunter web player:\n  this machine: http://127.0.0.1:%s/\n  your tailnet: https://%s:%s/  (tailnet-only; Ctrl-C to stop)\n' "$port" "$host" "$port" >&2
# Foreground mode: Tailscale removes this HTTPS handler when we stop.
tailscale serve --https="$port" "http://127.0.0.1:$port"

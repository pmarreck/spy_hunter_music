#!/usr/bin/env bash
set -u
scratch="$(mktemp -d "${TMPDIR:-/tmp}/spy-hunter-tests.XXXXXX")" || exit 1
trap '[[ ! -e "$scratch/terminal" ]] || unlink "$scratch/terminal"; [[ ! -e "$scratch/probe" ]] || unlink "$scratch/probe"; rmdir "$scratch"' EXIT
extra=()
[[ "$(uname -s)" != Linux ]] || extra=(-lutil)
"${CC:-cc}" -std=c11 -D_DEFAULT_SOURCE -Wall -Wextra -Werror tests/terminal.c src/cli/terminal.c "${extra[@]}" -o "$scratch/terminal" || exit 1
"${CC:-cc}" -std=c11 -D_DEFAULT_SOURCE -Wall -Wextra -Werror tests/probe.c src/cli/terminal.c "${extra[@]}" -o "$scratch/probe" || exit 1
"$scratch/probe" || exit 1
"$scratch/terminal" || exit 1
printf 'PASS: PTY keys, signals, kitty probe and idempotent terminal restoration\n'
